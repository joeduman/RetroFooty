{
  "name": "retrofooty",
  "version": "15.1.0",
  "private": true,
  "description": "RetroFooty online park with persistent neural imitation, self-play reinforcement training, strict benchmark promotion and backward-compatible Expert AI",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "stop": "node stop.js",
    "test": "node --test tests/*.test.mjs",
    "test:simulation": "node tests/simulate.mjs",
    "test:online": "node --test tests/online.test.mjs",
    "test:neural": "node --test tests/neural-policy.test.mjs",
    "training": "python train/train.py --cycles 1",
    "training:overnight": "python train/overnight.py --hours 8",
    "ai:compare": "node tests/ai-dev-server.mjs",
    "ai:tournament": "node tests/ai-tournament.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ws": "8.22.1"
  }
}
